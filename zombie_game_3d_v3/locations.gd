    "loc38": 13, "loc39": 13, "loc40": 13, "loc41": 13, "loc42": 13,
    "loc43": 13, "loc44": 13, "loc45": 13, "loc46": 13, "loc47": 13,
}
const RED_DEPTH_MAX := 13
# Кількість червоних черепів (0..10) на карті; остання карта — рівно 10.
const RED_SKULLS := {
    "loc14": 1, "loc15": 2, "loc16": 2, "loc17": 3, "loc18": 4, "loc19": 5, "loc20": 5,
    "loc21": 6, "loc22": 7, "loc23": 8, "loc24": 8, "loc25": 9, "loc26": 9, "loc27": 10,
    "loc28": 10, "loc29": 10, "loc30": 10, "loc31": 10, "loc32": 10,
    "loc33": 10, "loc34": 10, "loc35": 10, "loc36": 10, "loc37": 10,
    "loc38": 10, "loc39": 10, "loc40": 10, "loc41": 10, "loc42": 10,
    "loc43": 10, "loc44": 10, "loc45": 10, "loc46": 10, "loc47": 10,
}
# Множник здоров'я зомбі на останній карті (на проміжних росте рівномірно від 1.0).
const RED_HP_MAX_MULT := 2.0

static func red_skulls(loc: Dictionary) -> int:
    return int(RED_SKULLS.get(String(loc["id"]), 0))

static func red_hp_mult(loc: Dictionary) -> float:
    var d := int(RED_DEPTH.get(String(loc["id"]), 0))
    return 1.0 + (RED_HP_MAX_MULT - 1.0) * float(d) / float(RED_DEPTH_MAX)

static func by_id(id: String) -> Dictionary:
    for l in DATA:
        if l["id"] == id:
            return l
    return DATA[0]

