# замінюються червоними (RED_SKULLS), а здоров'я зомбі зростає (red_hp_mult): від ×1.00 на Замку епіцентру
# до ×2.00 на «Палаючій трясовині» (10 червоних черепів). Гілки loc23 і loc24 однакової глибини.
# RED_DEPTH — «глибина» локації за ланцюжком після Замку епіцентру (1..13), від неї рахується множник здоров'я.
const RED_DEPTH := {
    "loc14": 1, "loc15": 2, "loc16": 3, "loc17": 4, "loc18": 5, "loc19": 6, "loc20": 7,
    "loc21": 8, "loc22": 9, "loc23": 10, "loc24": 10, "loc25": 11, "loc26": 12, "loc27": 13,
    "loc28": 13, "loc29": 13, "loc30": 13, "loc31": 13, "loc32": 13,
