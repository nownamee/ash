static func briefing(loc: Dictionary) -> Dictionary:
    if loc.has("campaign"):
        var campaign_names := {
            "tide": "Чорний приплив",
            "bells": "Хор порожніх дзвонів",
            "glass": "Скляна ніч",
            "iron": "Залізний мор",
        }
        var campaign_name := String(campaign_names.get(String(loc["campaign"]), String(loc["campaign"])))
        var stage := int(loc.get("stage", 1))
        var waves := int(loc["waves"])
        var text := "Літопис кампанії «%s», стадія %d із 5. Цей бій складатиметься з %d хвиль; ватажок вийде лише наприкінці, у фінальній." % [campaign_name, stage, waves]
        if stage == 4:
            var objective := {"tide": "Утримайся 45 секунд у позначеному подвір’ї, і світло маяка спалахне знову.", "bells": "Зруйнуй три резонатори, і хвилі гулу вщухнуть.", "glass": "Розбий три дзеркальні вузли, і відлуння, що плодить двійників, замовкне.", "iron": "Зруйнуй три приводи, і підступні механізми застигнуть."}
            text += "\n\n" + String(objective[String(loc["campaign"])])
        elif stage == 5:
            text = "Літопис кампанії «%s», фінальна стадія 5 із 5. Останню хвилю очолить головний ватажок: це вирішальна мить." % campaign_name
        return {"who": "Хроніст кампанії «%s»" % campaign_name, "text": text}
    if loc["id"] == "loc4":
        return {"who": "Сержант Орест, розвідник",
            "text": "Слухай уважно, бійцю. З пагорба дозорні побачили: уся пустеля зрушила з місця. Мумії, розбійники й мертві каравани суне на шлях єдиною лавою.\n\nТут не буде ні п’яти хвиль, ні перепочинку поміж ними. Буде ОДНА велика хвиля, якій немає рівних за силою, і вона не вщухне, доки не впаде їхній ватажок.\n\nНе кидайся розтягувати їх по пісках: оточать. Тримайся ближче до замку, бережи здоров’я й не ловь гав. Нехай щастить, воно тобі знадобиться."}
    if loc["id"] == "loc8":
        return {"who": "Старий дзвонар Матвій, останній живий",
            "text": "Бійцю... Село вимерло, та мертві тут не ходять юрбами. Вони стоять, де впали: у дворах, поміж хатами, на цвинтарі, біля криниць. Сплять, якщо це можна назвати сном.\n\nХвиль не буде. Буде зачистка: тобі належить обійти ВСЕ село й упокоїти кожного. Ніхто не кинеться здалеку, та підійдеш ближче ніж на п’ять-десять кроків — прокинеться. Поодинці вони півбіди, а розбудиш гурт — притулися спиною до стіни.\n\nСтеж за мінікартою: червоні точки — ті, що ще стоять. Коли лишиться жменя, вони виявлять себе стрілками на краю карти. Серед них і ватажок, він теж спить десь у глибині.\n\nНіхто не повинен лишитися. Іди."}
    if loc["id"] == "loc10":
        return {"who": "Командор Айвор, лицарі застави",
            "text": "Бійцю! Ми тримаємо стару заставу на дорозі до фортеці. Шлях від вашої бази тихий: мертві туди майже не забрідають, тож дійдете спокійно.\n\nАле дозорні бачили, що чума суне сюди. ОДНА величезна хвиля, і йде вона просто на наш замок. Стіни стародавні, а якщо замок впаде, дорога на фортецю закрита для всіх.\n\nМи, лицарі, стоятимемо поруч, та нас мало. Не дайте їм розбити мури: убивайте тих, що б’ють по стінах. Здоров’я замку видно вгорі екрана. Тримайте його, доки не впадуть усі, разом із ватажком.\n\nЗа замок!"}
    if loc["id"] == "loc13":
        return {"who": "Капітан Роман, командир залоги",
            "text": "Бійцю, в нас лишилась остання надія. Глибоко в мертвому мегаполісі, на краю старого кварталу, ще тримається поранений лицар: тільки він знає, як зупинити те, що тут виросло. Нам його не дістати: вулиці кишать зараженими.\n\nЙди головною дорогою на північ: вона веде просто до нього, збитися важко. Шлях далекий, понад три сотні кроків, а мертвих на ньому — тьма. Вони йдуть без упину, цілими юрбами, і так само чекатимуть на зворотному шляху. Не барися надовго й не дай себе оточити.\n\nЯк знайдеш лицаря, він піде за тобою. Та він змучений і ранений: зомбі нападатимуть і на нього, а як він загине, все було марно. Оборони його й приведи до воріт замку. Місію виконано лише тоді, коли він переступить поріг.\n\nНе підведи нас."}
    if loc["id"] == "loc15":
        return {"who": "Болотяр Тарас, провідник",
            "text": "Бійцю, не ступай у світло-зелені калюжі. Це кислота. Мертвим вона байдужа: вони ходять нею, мов росою. А тебе роз’їсть і ще й сповільнить, щоб легше було доконати.\n\nКалюж тут повно, і розкидані вони густо. Дивись під ноги, бийся на сухих острівцях і заманюй мерців до калюж, а сам у них не стій. Їхні плювальники теж цілять у тебе.\n\nЗдолаєш три хвилі, і в останній вийде болотний жах.\n\nОбережно."}
    if loc["id"] == "loc16":
        return {"who": "Розвідниця Мирослава, північний дозор",
            "text": "Бійцю, за болотами починається тундра. Колись там пролягав тракт, а нині це цвинтар під відкритим небом: мертві застигли там, де їх застала зима.\n\nХвиль не буде. Це зачистка: треба пройти всю тундру й упокоїти кожного. Вони сплять під памороззю, та підійдеш на кілька кроків — прокинуться. Тут нові почвари: обмерзлі мисливці, крижані привиди, лицарі вічної зими й вендіго, що кидаються з лісу. Усі вони міцніші за звичайних мерців.\n\nСтеж за мінікартою. Коли лишиться жменя, вона покаже їх стрілками на краю. Серед них крижаний лич, і він теж спить десь далеко.\n\nНіхто не повинен лишитися. Іди."}
    if loc["id"] == "loc18":
        return {"who": "Пожежник Степан, останній з бригади",
            "text": "Бійцю, це місце горить уже багато днів, і полум’я не вщухає. Колись тут був цілий квартал, а нині самі балки та жар.\n\nМертві тут особливі: вони вигоріли зсередини й вийшли з полум’я. Обвуглені прудкі живі факели, що вибухають, вогнеплюї й тліючі велетні. Буде чотири хвилі, і зомбі в кожній однакові за силою, зате з кожною їх більшає.\n\nТримайся подалі від багать, не дай загнати себе в кут і не підпускай факелів упритул. Їхній володар вийде в останній хвилі.\n\nНехай щастить, воно тобі знадобиться."}
    if loc["id"] == "loc20":
        return {"who": "Командор Айвор, лицарі застави",
            "text": "Бійцю! Вогонь прийшов у ліс швидше за нас. Наша застава палає: стіни тліють, вежі в полум’ї, і воно не вщухає, навіть коли довкола нікого немає. Щосекунди замок сам втрачає міцність.\n\nА з лісу суне велика хвиля, і мерці, що вийшли з вогню, б’ють по мурах удвічі дужче. Довкола повно полум’я, тож не лізь у нього: воно пече лише тебе.\n\nЧас працює проти нас: чим швидше розтрощимо хвилю, тим менше згорить. Здоров’я замку вгорі екрана. Якщо воно впаде до нуля, нічого не лишиться.\n\nЗа замок!"}
    if loc["id"] == "loc22":
        return {"who": "Пожежник Степан, останній з бригади",
            "text": "Бійцю, ось воно. Звідси все почалося: в самому серці пожежі горить те, що ніколи не мало горіти. Жар тут такий, що земля світиться.\n\nБуде п’ять хвиль, і кожна міцніша за попередню. Остання стане справжнім пеклом: кілька велетнів і громил одночасно. Не стій на місці, не лізь у багаття й не дай загнати себе в кут.\n\nЯкщо витримаєш, шлях до магмового ядра відкриється.\n\nНехай щастить, воно тобі знадобиться."}
    if loc["id"] == "loc23":
        return {"who": "Пожежник Степан, останній з бригади",
            "text": "Бійцю, ти дійшов туди, куди не доходив ніхто. Під серцем пожежі лежить магмове ядро: тут вогонь не горить, а тече.\n\nМерці тут розжарені до білого й міцніші за всіх, кого ти бачив. П'ять хвиль, а наприкінці їхній володар, магмовий титан. Тримайся руху й бий тих, що виринають із лави, першими.\n\nКажуть, хто пройде це місце, зможе викувати броню з самої магми. Вона переливається, як річка вогню, і б'ється разом із тим, хто її носить.\n\nІди. За всіх, кого забрав вогонь."}
    if loc["id"] == "loc17":
        return {"who": "Командор Айвор, лицарі цитаделі",
            "text": "Бійцю! Ми дійшли до краю карти й тримаємо цю цитадель з останніх сил. Далі лише попіл та крига.\n\nДозорні бачать усю північ: до мурів суне ОДНА величезна хвиля. Вона йде на наш замок, а за нею — їхній володар. Якщо мури впадуть, цитадель буде втрачено, а разом із нею всіх, хто стоїть за нею.\n\nДорога від бази тиха, ідіть нею. Ми, лицарі, стоятимемо поруч, та нас мало. Убивайте тих, що б’ють по стінах. Здоров’я замку видно вгорі екрана.\n\nЗа цитадель!"}
    if loc["id"] == "loc24":
