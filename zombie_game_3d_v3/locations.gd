}
# Множник здоров'я зомбі на останній карті (на проміжних росте рівномірно від 1.0).
const RED_HP_MAX_MULT := 2.0

static func red_skulls(loc: Dictionary) -> int:
    return int(RED_SKULLS.get(String(loc["id"]), 0))

static func red_hp_mult(loc: Dictionary) -> float:
    var d := int(RED_DEPTH.get(String(loc["id"]), 0))
    return 1.0 + (RED_HP_MAX_MULT - 1.0) * float(d) / float(RED_DEPTH_MAX)

static func by_id(id: String) -> Dictionary:
    for l in DATA:
        if l["id"] == id:
            return l
    return DATA[0]

