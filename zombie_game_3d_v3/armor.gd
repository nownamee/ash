# Локація, після проходження якої відкривається рівень (порожній рядок — доступний одразу).
static func unlock_loc(tier: int) -> String:
    if tier >= MAGMA_TIER:
        return MAGMA_LOC
    if tier >= GHOST_TIER:
        return GHOST_LOC
    if tier > BASE_TIER:
        return UNLOCK_LOC
    return ""

# Ключ у GameState.armor: для «Звичайної броні» — просто слот (сумісно зі старими збереженнями), для інших — «слот@комплект».
static func key(slot: String, set_idx: int) -> String:
    if set_idx == 0:
        return slot
    return "%s@%s" % [slot, String(SETS[set_idx]["id"])]

static func all_keys() -> Array:
    var out: Array = []
    for si in range(SETS.size()):
        for slot in SLOTS:
            out.append(key(String(slot), si))
    return out

# До якого комплекту належить наскрізний рівень.
static func set_of_tier(tier: int) -> int:
    for si in range(SETS.size()):
        if tier >= int(SETS[si]["first"]) and tier <= int(SETS[si]["last"]):
            return si
    return 0

static func set_first(si: int) -> int:
    return int(SETS[si]["first"])

static func set_last(si: int) -> int:
    return int(SETS[si]["last"])

static func defense(slot: String, tier: int) -> float:
    return float(DEFENSE[slot][tier])

static func price(slot: String, tier: int) -> int:
    return int(PRICE[slot][tier])
